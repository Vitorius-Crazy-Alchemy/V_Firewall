<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vitorius</vendor>
  <vendor_url>https://github.com/Vitorius-Crazy-Alchemy/V_Firewall</vendor_url>

  <action id="com.v.firewall.pkexec.helper">
    <description>Manage V Firewall rules and network security policies</description>
    <message>Authentication is required to modify system firewall rules and security policies</message>
    <icon_name>v-firewall</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/v-firewall-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
